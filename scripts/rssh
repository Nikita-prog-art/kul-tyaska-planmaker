#!/usr/bin/env bash
# Resilient ssh wrapper (RKN drops connections): retries with backoff.
# Если провайдер режет 22-й порт, укажи локальный прокси — ssh пойдёт через него:
#   KT_SSH_PROXY=socks5://127.0.0.1:10808 scripts/rssh 'hostname'
HOST="${DEPLOY_HOST:-nikita@162.254.85.195}"
attempts="${RSSH_ATTEMPTS:-6}"
SSH_OPTS=(-F /dev/null -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
if [ -n "${KT_SSH_PROXY:-}" ]; then
  ROOT="$(cd "$(dirname "$0")" && pwd)"
  SSH_OPTS+=(-o "ProxyCommand=python3 $ROOT/ssh-relay.py %h %p")
fi
i=0
while :; do
  i=$((i+1))
  ssh "${SSH_OPTS[@]}" "$HOST" "$@"
  rc=$?
  [ "$rc" -eq 0 ] && exit 0
  if [ "$i" -ge "$attempts" ]; then
    echo "rssh: giving up after $i attempts (last rc=$rc)" >&2
    exit "$rc"
  fi
  echo "rssh: attempt $i failed (rc=$rc), retrying in $((i*3))s..." >&2
  sleep $((i*3))
done
